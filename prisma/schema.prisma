generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fields mirror src/lib/types.ts exactly. Dates are kept as "YYYY-MM-DD"
// strings (not native DateTime) because the calculation engine
// (src/lib/engine.ts, src/lib/date.ts) parses them as plain month/day
// integers and never needs timezone-aware timestamps.
model Expense {
  id                  String  @id @default(uuid())
  name                String
  amount              Float
  type                String
  frequency           String
  startDate           String
  endDate             String?
  active              Boolean @default(true)
  color               String
  notes               String?
  creditInitialAmount Float?
  /// Credits only: amount already repaid *before* the credit was entered in
  /// the app (never recorded as a Payment, never touches Dépenses or
  /// Disponible). Display-only: total = creditInitialAmount + this.
  creditPriorPaid     Float?
  linkedExpenseId     String?
  /**
   * Optional custom emoji shown in lists (e.g. "🚗"). Falls back to a
   * generic icon derived from `color` when not set.
   */
  icon                String?
  /// User-managed category (Réglages). Deleting a category keeps its
  /// expenses, just uncategorized.
  categoryId          String?
  createdAt           String
  updatedAt           String

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments     Payment[]
  daret        Daret?
  /// A goal deposit recorded as this (paid, one-time) expense.
  goalDeposits GoalDeposit[]
  /// A credit's money received when it was taken.
  incomes      Income[]
  /// Money put into the savings (Épargne), shown in Dépenses.
  savingsMove  SavingsMove?
  /// Money lent (Prêts), shown in Dépenses.
  loan         Loan?

  @@map("expenses")
}

// A daret (tontine) the user takes part in. Its monthly contribution is an
// ordinary temporary Expense (so it shows up in Dépenses, can be checked off
// and counts toward Disponible with no special-casing); this table only adds
// what's specific to a daret. The expense's startDate is the daret's first
// month and it runs for `members` months, one collection per member.
model Daret {
  id               String  @id @default(uuid())
  expenseId        String  @unique
  /// Number of participants = number of months the daret runs.
  members          Int
  /// "YYYY-MM": the month the user collects the pot.
  turnMonth        String
  /// Payout collected on the turn: how ("cash" / "card") and when (ISO);
  /// both null until the user confirms it.
  payoutMethod     String?
  payoutReceivedAt String?
  createdAt        String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("darets")
}

// Records an *actual* confirmed payment. Absence of a row means "not paid" —
// unpaid months/slots are never stored, only derived by the engine, so
// marking something paid can never retroactively rewrite prior history.
//
// Two addressing modes, exactly one populated depending on the expense type:
// - Non-credit (permanent/temporary): `monthKey` ("YYYY-MM") identifies which
//   month's occurrence this payment settles. One row per due month.
// - Credit: `slotIndex` (1-based) identifies which sequential installment
//   this is — NOT tied to a calendar month, because a missed installment
//   pushes every later one (and the credit's end date) forward by one month
//   instead of stacking onto the next month's due amount.
model Payment {
  id         String  @id @default(uuid())
  expenseId  String
  monthKey   String?
  slotIndex  Int?
  amountDue  Float
  amountPaid Float
  paidAt     String
  /// How it was paid: "cash" or "card" (null for older payments).
  method     String?
  createdAt  String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, monthKey])
  @@unique([expenseId, slotIndex])
  @@map("payments")
}

// Singleton row (id is always 1).
model Settings {
  id                  Int     @id @default(1)
  salary              Float
  currency            String
  savingsTarget       Float
  startMonth          String
  theme               String  @default("system")
  /// Day of the month the salary arrives (1-31; clamped to short months).
  payDay              Int     @default(1)
  /// "YYYY-MM" of the last pay day whose salary was confirmed received (the
  /// Accueil countdown asks once the pay day arrives).
  salaryReceivedMonth String?
  /// How the salary is received: "cash" or "card".
  salaryMethod        String  @default("card")

  @@map("settings")
}

// Expense categories shown as a swipeable picker on "Ajouter une dépense",
// fully editable (add, rename, re-emoji, reorder, delete) in Réglages.
model Category {
  id        String @id @default(uuid())
  name      String
  emoji     String
  /// Display order, ascending.
  position  Int
  createdAt String

  expenses Expense[]

  @@map("categories")
}

/// A savings goal (car, house, trip…). Progress = what's already saved plus
/// the payouts of the darets attached to it (each counted in its turn month).
model Goal {
  id            String   @id @default(uuid())
  name          String
  emoji         String
  targetAmount  Float
  /// Money already put aside for this goal (grows with "+ Versement").
  savedAmount   Float    @default(0)
  /// Optional planned saving per month, used for the estimated finish date.
  monthlySaving Float?
  /// Optional "YYYY-MM" deadline.
  deadline      String?
  /// Darets whose payout goes to this goal.
  daretIds      String[] @default([])
  position      Int      @default(0)
  createdAt     String

  deposits GoalDeposit[]

  @@map("goals")
}

/// Money put aside for a goal ("+ Versement"), with an optional label.
model GoalDeposit {
  id        String  @id @default(uuid())
  goalId    String
  name      String
  amount    Float
  /// "YYYY-MM-DD"
  date      String
  /// Taken from cash or the card ("cash" / "card"); null for older deposits.
  method    String?
  /// The paid one-time expense it shows as in Dépenses (deleted with it).
  expenseId String?
  createdAt String

  goal    Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_deposits")
}

/// The user's own goal ideas, shown after the built-in ones (Voiture, Maison…).
model GoalIdea {
  id        String @id @default(uuid())
  emoji     String
  name      String
  createdAt String

  @@map("goal_ideas")
}

/// Calendrier: a free note on one day.
model DayNote {
  /// "YYYY-MM-DD"
  date      String @id
  text      String
  updatedAt String

  @@map("day_notes")
}

/// Advance on salary: money received before the pay day. It adds to the
/// month it's taken in, and comes off the salary of `period`.
model SalaryAdvance {
  id        String @id @default(uuid())
  amount    Float
  /// "YYYY-MM-DD" it was received.
  date      String
  /// "YYYY-MM" of the pay day whose salary it is deducted from.
  period    String
  /// How it was received: "cash" or "card".
  method    String @default("card")
  createdAt String

  @@map("salary_advances")
}

/// A salary confirmed received (Solde history): what came in, and where.
model SalaryReceipt {
  id        String @id @default(uuid())
  /// "YYYY-MM" of the pay day.
  period    String @unique
  /// Salary minus the advances already taken on it.
  amount    Float
  method    String
  createdAt String

  @@map("salary_receipts")
}

/// Solde: a transfer between cash and card, or an adjustment of one account
/// to its real amount (kind "adjust", signed amount on `toAccount`).
model WalletOp {
  id          String  @id @default(uuid())
  kind        String
  fromAccount String?
  toAccount   String?
  amount      Float
  note        String?
  createdAt   String

  @@map("wallet_ops")
}

/// Extra income (prime, freelance, cadeau…), on top of the salary. It adds
/// to the money of the month it's received.
model Income {
  id        String  @id @default(uuid())
  name      String
  amount    Float
  /// "YYYY-MM-DD" received.
  date      String
  /// Key of one of the income categories (see lib/income.ts).
  category  String
  /// How it was received: "cash" or "card".
  method    String  @default("cash")
  notes     String?
  /// The credit this money came from (deleted with it).
  expenseId String?
  createdAt String

  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Money taken out of the savings, shown in Revenus.
  savingsMove   SavingsMove?
  /// A loan's repayment received, shown in Revenus.
  loanRepayment LoanRepayment?

  @@map("incomes")
}

/// Épargne: money put aside ("in": leaves cash / the card, shows in Dépenses
/// as a paid expense) or taken back ("out": comes into cash / the card,
/// shows in Revenus). The savings = what's in (paid) − what's out.
model SavingsMove {
  id        String  @id @default(uuid())
  kind      String
  amount    Float
  /// The account it leaves ("in") or goes to ("out"): "cash" / "card".
  method    String
  note      String?
  /// "YYYY-MM-DD"
  date      String
  expenseId String? @unique
  incomeId  String? @unique
  createdAt String

  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  income  Income?  @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@map("savings_moves")
}

/// Prêts: money lent to someone (the reverse of a credit). It leaves cash /
/// the card (a paid expense in Dépenses) and comes back in installments,
/// each confirmed received as an income.
model Loan {
  id          String  @id @default(uuid())
  /// Who it was lent to.
  name        String
  amount      Float
  /// Already given back before the loan was added here (not in the Solde).
  priorRepaid Float?
  /// "YYYY-MM-DD" lent.
  date        String
  /// Taken from "cash" / "card"; null when it didn't leave the Solde.
  method      String?
  /// Planned installment (the last one takes what's left).
  monthly     Float
  months      Int
  /// "YYYY-MM" of the first repayment.
  startMonth  String
  note        String?
  expenseId   String? @unique
  createdAt   String

  expense    Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]

  @@map("loans")
}

/// One installment of a loan, received in cash or on the card.
model LoanRepayment {
  id        String  @id @default(uuid())
  loanId    String
  /// 1-based installment number.
  slot      Int
  amount    Float
  method    String
  /// "YYYY-MM-DD" received.
  date      String
  incomeId  String? @unique
  createdAt String

  loan   Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  income Income? @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@unique([loanId, slot])
  @@map("loan_repayments")
}
